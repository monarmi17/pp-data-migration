# Dockerfile for Import Error Analysis
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Copy requirements file first for better caching
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy the error analysis scripts
COPY analyze_region_orders_import_errors.py .
COPY analyze_products_import_errors.py .

# Create necessary directories
RUN mkdir -p import-results error-analysis

# Default command (will be overridden by docker-compose services)
CMD ["python", "analyze_region_orders_import_errors.py"]
