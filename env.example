# Environment variables for production mode
# Set one of the following:

# Option 1: Specify the exact orders file name
# ORDERS_FILE=Sales_By_Customer_Auburn_Bay.xlsx

# Option 2: Specify the region name directly
# REGION_NAME=auburn_bay

# Examples:
# For Auburn Bay region:
# ORDERS_FILE=Sales_By_Customer_Auburn_Bay.xlsx
# or
# REGION_NAME=auburn_bay

# For Beddington region:
# ORDERS_FILE=Sales_By_Customer_Beddington.xlsx
# or
# REGION_NAME=beddington

# For testing custom product names with pattern analysis:
# CUSTOM_NAMES="Product 1 Product 2 Product 3"
# Example: CUSTOM_NAMES="Kong Dog Toy 2-Pack Hills Diet 5 lb Blue Buffalo Large"
