.DS_Store
.env

# Processed output directory (legacy)
processed/

# Output directory with Matrixify CSV files (legacy)
output/
output/matrixify_orders.csv

# New directory structure - output directories (ignore contents but keep directories)
order-line-items-with-product-codes/*
!order-line-items-with-product-codes/.gitkeep
matrixify-ready-orders/*
!matrixify-ready-orders/.gitkeep
matrixify-ready-products/*
!matrixify-ready-products/.gitkeep
import-results/*
!import-results/.gitkeep

# Error/ignored rows directory (ignore contents but keep directory)
error-rows/*
!error-rows/.gitkeep

# Error analysis directory (ignore contents but keep directory)
error-analysis/*
!error-analysis/.gitkeep

# Product name pattern analysis directory (ignore contents but keep directory)
product-name-pattern-analysis/*
!product-name-pattern-analysis/.gitkeep

# Original data directory (ignore contents but keep directory)
datasource/original-data/*
!datasource/original-data/.gitkeep

# Log files and directory (ignore contents but keep directory)
logs/*
!logs/.gitkeep
*.log

# Comparison script outputs (reimport xlsx, JSON logs)
comparison-reports/*
!comparison-reports/.gitkeep

# Shopify order exports (split per location + no-location)
shopify-may-orders-export/*
!shopify-may-orders-export/.gitkeep

# Shopify orders folder (raw exports + legacy split files)
shopify-orders/*
!shopify-orders/.gitkeep
shopify-orders/raw/*
!shopify-orders/raw/.gitkeep

# No Scan filtered order exports
filtered-orders-no-scans/*
!filtered-orders-no-scans/.gitkeep

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# LibreOffice lock files
*.~lock.*

clean_variant_fixer.py
analyze_remaining_duplicates.py