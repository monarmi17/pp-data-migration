# Dockerfile for Pattern Analysis Scripts
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy product name pattern analysis scripts
COPY generate_product_name_pattern_examples.py .
COPY validate_product_name_pattern_examples.py .
COPY products_to_matrixify.py .

# Create product-name-pattern-analysis directory
RUN mkdir -p product-name-pattern-analysis

# Set Python path
ENV PYTHONPATH=/app

# Default command (can be overridden)
CMD ["python", "generate_product_name_pattern_examples.py", "--help"]
